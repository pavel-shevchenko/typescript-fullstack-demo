# Comfort demo — Jenkins envsubst template (underscore-prefixed variables come from the agent)
WORKSPACE_TIMEZONE=Europe/Moscow
DOCKER_BUN_VERSION=1.2.23-alpine

# === Local dev ports (published on host) ===
WEB_PORT=4500
CMS_API_PORT=4501
CRM_API_PORT=4502
PYTHON_CODING_PORT=4503
SEARCH_API_PORT=4504

# === Prod branch ports (inside DinD, см. docker-compose-host + Caddy) ===
DOMAIN_MAIN_BRANCH=${_DOMAIN_MAIN_BRANCH}
DOMAIN_TEST_BRANCH=${_DOMAIN_TEST_BRANCH}
MAIN_BRANCH_API_CMS_PORT=2000
MAIN_BRANCH_API_CRM_PORT=2001
MAIN_BRANCH_FRONTEND_PORT=2002
TEST_BRANCH_API_CMS_PORT=2003
TEST_BRANCH_API_CRM_PORT=2004
TEST_BRANCH_FRONTEND_PORT=2005
MAIN_BRANCH_API_SEARCH_PORT=2006
TEST_BRANCH_API_SEARCH_PORT=2007

# === Public URLs ===
NEXT_PUBLIC_SERVER_URL=${_NEXT_PUBLIC_SERVER_URL}
BASE_URL_OF_API_CMS=http://api-cms:3000/api-cms/
BASE_URL_OF_API_CRM=http://api-crm:3000/api-crm/
BASE_URL_OF_API_SEARCH=http://api-search:3000/api-search/
PYTHON_CODING_URL=http://python-coding:8200
COMFORT_GENERATED_ROOT=/workspace/generated/runtime

# === Auth ===
JWT_SECRET=${_JWT_SECRET}
JWT_EXPIRES_IN_HOURS=720

# === Postgres clusters (CMS + CRM + search) ===
PG_USER=comfort
PG_PASSWORD=${_PG_PASSWORD}
PGCAT_ADMIN_USERNAME=pgcat_admin
PGCAT_ADMIN_PASSWORD=${_PGCAT_ADMIN_PASSWORD}
CMS_PG_DATABASE=comfort_cms
CRM_PG_DATABASE=comfort_crm
SEARCH_PG_DATABASE=comfort_search
# Base image for infrastructure/postgres/search-pg (hunspell RU/EN).
SEARCH_POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg18
CMS_DATABASE_URL=postgresql://comfort:${_PG_PASSWORD}@cms-pgcat:6432/comfort_cms?schema=public&sslmode=disable
CMS_DATABASE_DIRECT_URL=postgresql://comfort:${_PG_PASSWORD}@cms-pg-1:5432/comfort_cms?schema=public&sslmode=disable
CRM_DATABASE_URL=postgresql://comfort:${_PG_PASSWORD}@crm-pgcat:6432/comfort_crm?schema=public&sslmode=disable
CRM_DATABASE_DIRECT_URL=postgresql://comfort:${_PG_PASSWORD}@crm-pg-1:5432/comfort_crm?schema=public&sslmode=disable
# Main (PgCat): SEARCH_DATABASE_URL → search-pgcat. Test/local: both → search-pg-1 (override in compose).
SEARCH_DATABASE_URL=postgresql://comfort:${_PG_PASSWORD}@search-pgcat:6434/comfort_search?schema=public&sslmode=disable
SEARCH_DATABASE_DIRECT_URL=postgresql://comfort:${_PG_PASSWORD}@search-pg-1:5432/comfort_search?schema=public&sslmode=disable
PG_POOL_MAX=2

# === Redis / throttling ===
REDIS_URL=redis://redis:6379
THROTTLE_DOMAIN_PRISMA_LIMIT=50
THROTTLE_DOMAIN_PRISMA_TTL_MS=50000
DOMAIN_PRISMA_DEFAULT_TAKE=100
DOMAIN_PRISMA_MAX_TAKE=5000
DOMAIN_PRISMA_MAX_MUTATION_BATCH=500

# === SeaweedFS S3 ===
SEAWEEDFS_S3_ACCESS_KEY=${_SEAWEEDFS_S3_ACCESS_KEY}
SEAWEEDFS_S3_SECRET_KEY=${_SEAWEEDFS_S3_SECRET_KEY}
SEAWEEDFS_S3_HOST=seaweedfs
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_S3_REGION=us-east-1
SEAWEEDFS_S3_DEFAULT_BUCKET=${_SEAWEEDFS_S3_DEFAULT_BUCKET}

# === AI (optional) ===
OPENAI_API_KEY=${_OPENAI_API_KEY}
AI_PROXY_URL=${_AI_PROXY_URL}
GROQ_API_KEY=${_GROQ_API_KEY}

# === SMTP (не используется для регистрации в demo) ===
SMTP_HOST=${_SMTP_HOST}
SMTP_PORT=465
SMTP_USER=${_SMTP_USER}
SMTP_PASSWORD=${_SMTP_PASSWORD}
NOREPLY_EMAIL_FROM=${_NOREPLY_EMAIL_FROM}

# === Infisical optional (D5, docker-compose-infisical-optional.yml) ===
INFISICAL_TOKEN=${_INFISICAL_TOKEN}
INFISICAL_PROJECT_ID=${_INFISICAL_PROJECT_ID}
INFISICAL_ENVIRONMENT=prod
