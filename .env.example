# Comfort local development — runnable stubs (not for production).
# Sync with .env.example; keep SEARCH_* URLs on search-pg-1 (local compose has no search-pgcat).
COMPOSE_PROJECT_NAME=comfort
WORKSPACE_TIMEZONE=Europe/Moscow
DOCKER_BUN_VERSION=1.2.23-alpine

# === Local dev ports (published on host) ===
WEB_PORT=4500
CMS_API_PORT=4501
CRM_API_PORT=4502
PYTHON_CODING_PORT=4503
SEARCH_API_PORT=4504

# === Prod branch ports (inside DinD; unused by local docker-compose.yml) ===
DOMAIN_MAIN_BRANCH=comfort-demo.example
DOMAIN_TEST_BRANCH=test.comfort-demo.example
DOMAIN_FORGEJO=git.comfort-demo.example
MAIN_BRANCH_API_CMS_PORT=2000
MAIN_BRANCH_API_CRM_PORT=2001
MAIN_BRANCH_FRONTEND_PORT=2002
TEST_BRANCH_API_CMS_PORT=2003
TEST_BRANCH_API_CRM_PORT=2004
TEST_BRANCH_FRONTEND_PORT=2005
MAIN_BRANCH_API_SEARCH_PORT=2006
TEST_BRANCH_API_SEARCH_PORT=2007

# === Jenkins + Forgejo (host stack stubs) ===
JENKINS_MASTER_URL=http://127.0.0.1:8080/
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=comfort_jenkins_demo
FORGEJO_HTTP_HOST_PORT=3008
FORGEJO_SSH_HOST_PORT=2222
FORGEJO_ROOT_URL=https://git.comfort-demo.example/
FORGEJO_DATA_PATH=./infrastructure/forgejo/data
FORGEJO_DISABLE_REGISTRATION=true
FORGEJO_WEBHOOK_TOKEN=comfort_forgejo_webhook_demo
FORGEJO_ACCESS_TOKEN=
FORGEJO_SSH_PRIVATE_KEY_IN_BASE64=
FORGEJO_SSH_USERNAME=git
COMFORT_FORGEJO_REPOSITORY_URL=http://comfort-forgejo:3000/comfort/comfort.git
COMFORT_FORGEJO_REPOSITORY_SSH_URL=ssh://git@comfort-forgejo:22/comfort/comfort.git
MAIN_BRANCH_E2E_ADMIN_EMAIL=admin@comfort.local
MAIN_BRANCH_E2E_ADMIN_PASSWORD=comfort123
TEST_BRANCH_E2E_ADMIN_EMAIL=admin@comfort.local
TEST_BRANCH_E2E_ADMIN_PASSWORD=comfort123

# === Public URLs (in-compose DNS) ===
NEXT_PUBLIC_SERVER_URL=http://45.90.33.243:4500/
# Hostnames allowed to load Next.js /_next/* in `next dev` (comma-separated).
ALLOWED_DEV_ORIGINS=45.90.33.243
BASE_URL_OF_API_CMS=http://api-cms:3000/api-cms/
BASE_URL_OF_API_CRM=http://api-crm:3000/api-crm/
BASE_URL_OF_API_SEARCH=http://api-search:3000/api-search/
PYTHON_CODING_URL=http://python-coding:8200
COMFORT_GENERATED_ROOT=/workspace/generated/runtime

# === Auth ===
JWT_SECRET=comfort_demo_jwt_secret_change_in_prod_32chars
JWT_EXPIRES_IN_HOURS=720
# Set true only behind HTTPS. Plain HTTP (WEB_PORT) must stay false or the browser drops auth_token.
COOKIE_SECURE=false

# === Postgres (CMS + CRM + search) ===
PG_USER=comfort
PG_PASSWORD=comfort_demo_pg_password
PGCAT_ADMIN_USERNAME=pgcat_admin
PGCAT_ADMIN_PASSWORD=comfort_pgcat_admin
CMS_PG_DATABASE=comfort_cms
CRM_PG_DATABASE=comfort_crm
SEARCH_PG_DATABASE=comfort_search
SEARCH_POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg18
CMS_DATABASE_URL=postgresql://comfort:comfort_demo_pg_password@cms-pgcat:6432/comfort_cms?schema=public&sslmode=disable
CMS_DATABASE_DIRECT_URL=postgresql://comfort:comfort_demo_pg_password@cms-pg-1:5432/comfort_cms?schema=public&sslmode=disable
CRM_DATABASE_URL=postgresql://comfort:comfort_demo_pg_password@crm-pgcat:6433/comfort_crm?schema=public&sslmode=disable
CRM_DATABASE_DIRECT_URL=postgresql://comfort:comfort_demo_pg_password@crm-pg-1:5432/comfort_crm?schema=public&sslmode=disable
# Local: no search-pgcat — both point at primary. Main branch may use search-pgcat:6434 for SEARCH_DATABASE_URL.
SEARCH_DATABASE_URL=postgresql://comfort:comfort_demo_pg_password@search-pg-1:5432/comfort_search?schema=public&sslmode=disable
SEARCH_DATABASE_DIRECT_URL=postgresql://comfort:comfort_demo_pg_password@search-pg-1:5432/comfort_search?schema=public&sslmode=disable
PG_POOL_MAX=2

# === Redis / throttling ===
REDIS_URL=redis://redis:6379
THROTTLE_DOMAIN_PRISMA_LIMIT=50
THROTTLE_DOMAIN_PRISMA_TTL_MS=50000
DOMAIN_PRISMA_DEFAULT_TAKE=100
DOMAIN_PRISMA_MAX_TAKE=5000
DOMAIN_PRISMA_MAX_MUTATION_BATCH=500

# === SeaweedFS S3 ===
SEAWEEDFS_S3_ACCESS_KEY=comfort_s3
SEAWEEDFS_S3_SECRET_KEY=comfort_demo_seaweedfs_secret
SEAWEEDFS_S3_HOST=seaweedfs
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_S3_REGION=us-east-1
SEAWEEDFS_S3_DEFAULT_BUCKET=comfort1

# === AI (optional stubs) ===
OPENAI_API_KEY=
AI_PROXY_URL=
GROQ_API_KEY=

# === SMTP (unused for demo registration) ===
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
NOREPLY_EMAIL_FROM=hello@comfort-demo.example

# === DinD / prod compose stubs ===
COMFORT_APPS_HOST_PATH=/srv/comfort_apps
CONTAINER_NAME_PREFIX=comfort_
MONOREPO_ABS_PATH=./
BACKUP_DATA_ABS_PATH=./
